# Contoh environment variables untuk PMK Form Platform.
# Salin file ini ke .env (untuk lokal) atau set di dashboard Vercel (produksi).
# .env TIDAK boleh di-commit (sudah di .gitignore).

# --- Supabase (WAJIB) ---
# Dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...   # anon/public key, aman di browser

# --- Service role (WAJIB di server, JANGAN pernah expose ke browser) ---
# Dipakai server action: submitFormResponseAction, getRecruitmentFormOptions,
# /api/cek-hasil. Key ini bypass RLS - hanya boleh ada di server.
# Verifikasi tidak bocor: grep SUPABASE_SERVICE_ROLE_KEY .next/static (harus kosong)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Platform deployment (untuk rate limiting anti-spoof IP) ---
# Menentukan urutan header yang dipakai getClientIp() (lib/rate-limit.ts).
# Client tidak bisa memalsukan header yang diisi platform ini.
#
#   vercel       (DEFAULT saat env tidak di-set/kosong)
#                1. x-vercel-forwarded-for  2. x-real-ip  3. x-forwarded-for (hop terakhir)
#   cloudflare   1. cf-connecting-ip       2. x-forwarded-for (hop terakhir)
#   nginx        1. x-real-ip              2. x-forwarded-for (hop terakhir)
#                (pastikan nginx menulis: proxy_set_header X-Real-IP $remote_addr;)
#   none         hanya x-forwarded-for hop terakhir; HANYA untuk dev lokal,
#                JANGAN dipakai produksi tanpa proxy di depan
#
# Nilai TIDAK dikenal (mis. typo) fail-safe ke "vercel", bukan "none",
# agar proteksi anti-spoofing tidak hilang tanpa sengaja.
TRUSTED_PROXY=vercel

# --- Google Sheets service account (Fase 6, server saja) ---
# Dibuat di Google Cloud Console: service account + kunci JSON di-download.
# Spreadsheet harus di-share (sebagai Editor) ke email ini agar bisa ditulis.
# Private key di env ditulis dengan \n literal; kode mengubahnya menjadi
# newline asli (lihat lib/sheets/client.ts). JANGAN commit file nyata.
GOOGLE_SERVICE_ACCOUNT_EMAIL=pmk-form-sheets@pmk-form-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_SALINAN_JSON_SPLIT_N_DISINI\n-----END PRIVATE KEY-----\n"

# --- Cron retry Sheets (Fase 6, server saja) ---
# Secret acak untuk melindungi /api/cron/sheets-sync (constant-time compare).
# Hasilkan dengan: openssl rand -hex 32
CRON_SECRET=PASTE_STRING_ACAK_64_CHAR_DISINI
